<mxfile host="app.diagrams.net">
  <diagram name="BusAwu Activity Diagram" id="busawu-activity-diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
    <mxCell id="a1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="507" y="20" width="26" height="26" as="geometry" />
    </mxCell>
    <mxCell id="a2" value="Open the app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="420" y="80" width="220" height="50" as="geometry" />
    </mxCell>
    <mxCell id="a3" value="View live map
(bus marker + own location)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="420" y="170" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="a4" value="Search route?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="430" y="270" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="a5" value="Enter From/To stops" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="100" y="290" width="220" height="50" as="geometry" />
    </mxCell>
    <mxCell id="a6" value="System matches route against
active broadcast; show bus if match" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="90" y="380" width="240" height="60" as="geometry" />
    </mxCell>
    <mxCell id="a7" value="Scan QR code (BOARD)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="420" y="460" width="220" height="50" as="geometry" />
    </mxCell>
    <mxCell id="a8" value="Backend opens Trip
(board lat/lng, time)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="420" y="540" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="a9" value="Ride the bus
(live map keeps updating)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="420" y="630" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="a10" value="Scan QR code (EXIT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="420" y="720" width="220" height="50" as="geometry" />
    </mxCell>
    <mxCell id="a11" value="Backend calculates distance
(Haversine) and fare (tiered rate)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="410" y="800" width="240" height="60" as="geometry" />
    </mxCell>
    <mxCell id="a12" value="Balance sufficient?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="430" y="900" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="a13" value="Deduct fare from wallet;
