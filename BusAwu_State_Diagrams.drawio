<mxfile host="app.diagrams.net">

  <diagram name="Driver State Diagram" id="driver_state_diagram">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
    <mxCell id="driver_state_diagram_1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="24" height="24" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_2" value="Idle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="300" width="160" height="60" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_3" value="SelectingRoute" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="300" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_4" value="RouteSelected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="560" y="300" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_5" value="Broadcasting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="820" y="100" width="200" height="60" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_6" value="Reconnecting" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="820" y="300" width="200" height="60" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_7" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="1036" y="386" width="16" height="16" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_8" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="1030" y="380" width="28" height="28" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="driver_state_diagram_1" target="driver_state_diagram_2">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_10" value="open app" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_2" target="driver_state_diagram_3">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_11" value="select company &amp; route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_3" target="driver_state_diagram_4">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_12" value="tap &quot;Go Online&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_4" target="driver_state_diagram_5">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_13" value="tap &quot;Go Offline&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_5" target="driver_state_diagram_4">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_14" value="connection lost" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_5" target="driver_state_diagram_6">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_15" value="reconnected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_6" target="driver_state_diagram_5">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_16" value="reconnect failed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_6" target="driver_state_diagram_4">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_17" value="app closed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_4" target="driver_state_diagram_2">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="driver_state_diagram_18" value="GPS tick (every 2-3s) /
send location to backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver_state_diagram_5" target="driver_state_diagram_5">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1080" y="115" />
          <mxPoint x="1080" y="145" />
        </Array>
      </mxGeometry>
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

